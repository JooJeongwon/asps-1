{
  "name": "landing-page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env.local scripts/dev-server.js",
    "start": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "build": "tailwindcss -i styles/tailwind.css -o public/tailwind.css --minify",
    "test": "node --test worker.test.js tests/*.test.js",
    "cf:dev": "npm run build && npx wrangler dev"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3"
  }
}
